{
  "version": 1,
  "projects": {
    "public": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "styles": [
              "src/styles.css"
            ],
            "outputPath": "dist/public",
            "server": "src/main.server.ts",
            "outputMode": "server",
            "ssr": {"entry":"src/server.ts"},
            "outputHashing": "all",
            "security": {"allowedHosts":["localhost","127.0.0.1","public-ssr"]},
            "optimization": {
              "scripts": true,
              "styles": {
                "minify": true,
                "inlineCritical": false
              },
              "fonts": true
            }
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "public:build"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
