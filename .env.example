# Copiar a .env y definir una contraseña privada. No subir .env a Git.
DB_PASSWORD=
WEB_PORT=8080
# Captura LOCAL de correos: no envía a Internet.
MAIL_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Google SMTP, cuando dispongas de credenciales válidas:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_USERNAME=info@deportecuador.com.ec
# SMTP_PASSWORD=<secreto configurado fuera del repositorio>

# Optional integrations: disabled until explicitly configured. Never commit real credentials.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=
PUBLIC_SITE_URL=
# Phone, Calendar ID and hours are configured in Admin > WhatsApp y reservas.

# Account recovery and Google Workspace login (independent of Calendar).
ADMIN_PUBLIC_ORIGIN=http://localhost:8081
GOOGLE_OIDC_ENABLED=false
GOOGLE_OIDC_DOMAIN=deportecuador.com.ec
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:8081/login/oauth2/code/google
